---
import Logo from '@components/Logo-white.astro';
import Button from '@components/ui/Button.astro';
import { siteConfig } from '@data/config';
import { getEntry } from 'astro:content';
import { getLangFromUrl, localizedPath } from '@i18n/utils';

interface ButtonProps {
  text: string;
  link: string;
  target?: string;
}

interface Props {
  footerCta?: {
    title: string;
    description: string;
    hideCta: boolean;
    button: ButtonProps;
  };
}

const { footerCta } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const ui = await getEntry('ui', `${lang}/common`);
const t = ui!.data;

const defaultCta = {
  title: '',
  description: '',
  hideCta: true,
  button: { text: t.nav.contact, link: localizedPath('/contact', lang), target: '_self' },
};

const cta = footerCta || defaultCta;
const currentYear = new Date().getFullYear();

const footerMenu = [
  { name: t.nav.home, link: localizedPath('/', lang) },
  { name: t.nav.about, link: localizedPath('/about', lang) },
  { name: t.nav.contact, link: localizedPath('/contact', lang) },
];

const legalMenu = [
  { name: t.legal.privacy, link: localizedPath('/legal/privacy-policy', lang) },
  { name: t.legal.terms, link: localizedPath('/legal/terms-of-service', lang) },
];
---

<footer class={`bg-black text-white pb-small ${cta.hideCta ? 'pt-large' : ''}`}>
  <div class="site-container mx-auto px-4">
    {!cta.hideCta && (
      <div class="text-center border-b border-background-light mb-12 py-small">
        <h2 class="text-3xl font-bold mb-4" data-aos="fade-up">{cta.title}</h2>
        <p class="text-white mb-6 max-w-2xl mx-auto" data-aos="fade-up" data-aos-delay="100">
          {cta.description}
        </p>
        <Button
          href={cta.button.link}
          variant="ghostLight"
          size="lg"
          data-aos="fade-up"
          data-aos-delay="200"
          {...(cta.button.target && { target: cta.button.target })}
        >
          {cta.button.text}
        </Button>
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-8 border-b border-background-light">
      <div class="col-span-1">
        <Logo variant="footer" />
        <p class="mt-4 text-white">
          {t.footer.tagline}
        </p>
      </div>

      <div class="col-span-1">
        <h3 class="text-lg font-semibold mb-4">{t.footer.quickLinks}</h3>
        <nav>
          <ul class="space-y-2">
            {footerMenu.map(item => (
              <li><a href={item.link} class="text-body-dark hover:text-white transition-colors">{item.name}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </div>

    <div class="mt-8 flex flex-col md:flex-row justify-between items-center">
      <div class="text-body-dark text-sm">
        © {currentYear} {siteConfig.companyName}. {t.footer.rights}
      </div>

      <nav class="mt-4 md:mt-0">
        <ul class="flex flex-wrap gap-6">
          {legalMenu.map(item => (
            <li>
              <a
                href={item.link}
                class="text-sm text-body-dark hover:text-white transition-colors"
              >
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</footer>
