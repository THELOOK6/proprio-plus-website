---
import Logo from '@components/Logo.astro';
import { Menu, X } from 'lucide-astro';
import Button from '@components/ui/Button.astro';
import { getEntry } from 'astro:content';
import { getLangFromUrl, getAlternatePath, localizedPath, locales } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const ui = await getEntry('ui', `${lang}/common`);
const t = ui!.data;

const headerMenu = [
    { name: t.nav.home, link: localizedPath('/', lang) },
    { name: t.nav.about, link: localizedPath('/about', lang) },
    { name: t.nav.services, link: localizedPath('/services', lang) },
];

const ctaButton = { name: t.nav.contact, link: localizedPath('/contact', lang) };

// Language toggle targets (same page in each locale).
const langLinks = locales.map((l) => ({
    code: l,
    label: l.toUpperCase(),
    href: getAlternatePath(Astro.url, l),
    active: l === lang,
}));

const currentPath = Astro.url.pathname;
const isCurrentPage = (link: string) => {
    const home = localizedPath('/', lang);
    if (link === home) {
        return currentPath === link || currentPath === link.replace(/\/$/, '');
    }
    return currentPath.startsWith(link);
};
---

<header class="fixed top-0 z-50 w-full left-0">
    <div class="site-container mx-auto px-4 mt-4">
        <div class="flex justify-between items-center bg-white py-3 rounded-lg px-4 border-black border">
            <Logo />
            <nav class="relative flex items-center gap-2 lg:gap-8" aria-label="Site Navigation">
                {/* Desktop Menu */}
                <ul class="hidden lg:flex lg:gap-8 items-center">
                    {
                        headerMenu.map((item) => (
                            <li class="relative">
                                <a
                                    href={item.link}
                                    class:list={[
                                        'text-small font-medium rounded-md px-2 py-1 focus:outline-none focus:ring-2 focus:ring-nav-text-active',
                                        isCurrentPage(item.link)
                                            ? 'text-nav-text-current font-semibold'
                                            : 'text-nav-text hover:text-nav-text-hover',
                                    ]}
                                    aria-current={isCurrentPage(item.link) ? 'page' : undefined}
                                >
                                    {item.name}
                                </a>
                            </li>
                        ))
                    }

                    <Button href={ctaButton.link} variant="primary">{ctaButton.name}</Button>

                    {/* Language toggle */}
                    <li class="flex items-center gap-1 text-small font-medium pl-2 border-l border-black/10" aria-label={t.language.label}>
                        {langLinks.map((l, i) => (
                            <>
                                {i > 0 && <span class="text-nav-text/40" aria-hidden="true">|</span>}
                                <a
                                    href={l.href}
                                    hreflang={l.code}
                                    class:list={[
                                        'px-1 rounded focus:outline-none focus:ring-2 focus:ring-nav-text-active',
                                        l.active
                                            ? 'text-nav-text-current font-semibold'
                                            : 'text-nav-text hover:text-nav-text-hover',
                                    ]}
                                    aria-current={l.active ? 'true' : undefined}
                                >
                                    {l.label}
                                </a>
                            </>
                        ))}
                    </li>
                </ul>

                {/* Mobile Menu Button */}
                <button
                    class="mobile-menu-button relative z-30 p-2 border-none cursor-pointer bg-transparent lg:hidden"
                    aria-label="Toggle Menu"
                    aria-expanded="false"
                >
                    <span class="menu-icon block">
                        <Menu size={24} class="text-body-base" />
                    </span>
                    <span class="close-icon hidden">
                        <X size={24} class="text-white" />
                    </span>
                </button>

                {/* Mobile Menu Panel */}
                <div
                    class="mobile-menu fixed inset-0 z-20 px-8 pt-20 bg-primary lg:hidden hidden opacity-0 scale-95 transform transition-all duration-200 ease-out overflow-y-auto"
                >
                    <ul class="flex flex-col gap-4">
                        {
                            headerMenu.map((item) => (
                                <li>
                                    <a
                                        href={item.link}
                                        class:list={[
                                            'py-1 rounded-md focus:outline-none focus:ring-2 focus:ring-nav-mobile-text-active',
                                            isCurrentPage(item.link)
                                                ? 'text-nav-mobile-text-current font-semibold'
                                                : 'text-nav-mobile-text hover:text-nav-mobile-text-hover',
                                        ]}
                                        aria-current={isCurrentPage(item.link) ? 'page' : undefined}
                                    >
                                        {item.name}
                                    </a>
                                </li>
                            ))
                        }
                    </ul>

                    {/* Mobile language toggle — high-contrast pill buttons on the colored panel */}
                    <div class="mt-8 pt-6 border-t border-white/30">
                        <p class="text-white/80 text-sm font-medium mb-3">{t.language.label}</p>
                        <div class="flex items-center gap-3" aria-label={t.language.label}>
                            {langLinks.map((l) => (
                                <a
                                    href={l.href}
                                    hreflang={l.code}
                                    class:list={[
                                        'px-4 py-2 rounded-md text-sm font-semibold border-2 transition-colors',
                                        l.active
                                            ? 'bg-white text-primary border-white'
                                            : 'bg-transparent text-white border-white/80 hover:bg-white/15',
                                    ]}
                                    aria-current={l.active ? 'true' : undefined}
                                >
                                    {l.label}
                                </a>
                            ))}
                        </div>
                    </div>

                    <div class="mt-8 pb-8">
                        <Button href={ctaButton.link} variant="ghostLight">{ctaButton.name}</Button>
                    </div>
                </div>
            </nav>
        </div>
    </div>
</header>

<script>
    // Mobile menu toggle with scroll lock
    const mobileMenuButton = document.querySelector('.mobile-menu-button');
    const mobileMenu = document.querySelector('.mobile-menu');
    const menuIcon = document.querySelector('.menu-icon');
    const closeIcon = document.querySelector('.close-icon');

    mobileMenuButton?.addEventListener('click', () => {
        const isHidden = mobileMenu?.classList.contains('hidden');

        if (isHidden) {
            document.body.style.overflow = 'hidden';
            mobileMenu?.classList.remove('hidden');
            requestAnimationFrame(() => {
                mobileMenu?.classList.remove('opacity-0', 'scale-95');
                mobileMenu?.classList.add('opacity-100', 'scale-100');
            });
            menuIcon?.classList.add('hidden');
            closeIcon?.classList.remove('hidden');
        } else {
            document.body.style.overflow = '';
            mobileMenu?.classList.add('opacity-0', 'scale-95');
            mobileMenu?.classList.remove('opacity-100', 'scale-100');
            setTimeout(() => {
                mobileMenu?.classList.add('hidden');
            }, 200);
            menuIcon?.classList.remove('hidden');
            closeIcon?.classList.add('hidden');
        }
    });
</script>
