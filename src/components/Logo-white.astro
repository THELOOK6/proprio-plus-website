---
import { Image } from 'astro:assets';
import logo from '../assets/logo-alliance-horizontal-white-text.png';
import { getLangFromUrl, localizedPath } from '@i18n/utils';

interface Props {
    variant?: 'header' | 'footer' | 'dark';
}

const { variant = 'header' } = Astro.props;
const home = localizedPath('/', getLangFromUrl(Astro.url));
---

<a href={home} class:list={['logo']}>
    <Image src={logo} alt="Proprio+" class="visible" />
</a>
