---
import { getPaddingClass, getBackgroundColor, getTextColor, getHeadlineColor } from '@utils/styleUtils';
import type { PaddingSize, ThemeColor } from '@utils/styleUtils';
import { siteConfig } from '@data/config';
import { Mail, Phone, MapPin } from 'lucide-astro';
import Contact from '@components/forms/Contact.astro';
import Map from '@components/Map.astro';
import { getEntry } from 'astro:content';
import { getLangFromUrl } from '@i18n/utils';

export interface Props {
    background?: ThemeColor;
    padding?: PaddingSize;
    paddingTop?: PaddingSize;
    paddingBottom?: PaddingSize;
}

const {
    background = 'base',
    padding,
    paddingTop,
    paddingBottom
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const ui = await getEntry('ui', `${lang}/common`);
const t = ui!.data;

const bgColor = getBackgroundColor(background);
const textColor = getTextColor(background);
const headlineColor = getHeadlineColor(background);
const paddingClass = getPaddingClass({
    padding,
    paddingTop,
    paddingBottom
});

const contactDetails = [
    {
        icon: Mail,
        title: t.contact.email,
        details: siteConfig.Socials.Email,
        link: `mailto:${siteConfig.Socials.Email}`
    },
    {
        icon: Phone,
        title: t.contact.phone,
        details: siteConfig.Socials.Phone,
        link: `tel:${siteConfig.Socials.Phone}`
    },
    // {
    //     icon: MapPin,
    //     title: t.contact.address,
    //     details: siteConfig.Socials.Location,
    //     link: '#map'
    // },
];
---

<section class:list={[bgColor, paddingClass]}>
    <div class="site-container px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
            <div>
                <h2 class:list={['mb-8', headlineColor]}>{t.contact.getInTouch}</h2>
                <div class="space-y-6">
                    {contactDetails.map((item) => (
                        <a
                            href={item.link}
                            class="flex items-start gap-4 group"
                        >
                            <div class="p-3 rounded-lg bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white transition-colors">
                                <item.icon size={24} />
                            </div>
                            <div>
                                <h3 class:list={['text-lg font-semibold', headlineColor]}>{item.title}</h3>
                                <p class:list={[textColor, 'opacity-90']}>{item.details}</p>
                            </div>
                        </a>
                    ))}
                </div>
                <!-- Map Section -->
                <Map />
            </div>
            <div>
                <Contact />
            </div>
        </div>
    </div>
</section>


