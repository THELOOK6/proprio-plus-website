---
import Button from "@components/ui/Button.astro";
import Input from "@components/ui/form/Input.astro";
import Textarea from "@components/ui/form/Textarea.astro";
import Checkbox from "@components/ui/form/Checkbox.astro";
import { getEntry } from "astro:content";
import { getLangFromUrl } from "@i18n/utils";

const formBackground = 'light';
const lang = getLangFromUrl(Astro.url);
const ui = await getEntry('ui', `${lang}/common`);
const t = ui!.data.form;
---
<form
    name="contact"
    method="POST"
    data-netlify="true"
    class="space-y-6 bg-white p-6 rounded-lg"
>
    <!-- Hidden input for Netlify Forms -->
    <input type="hidden" name="form-name" value="contact" />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <Input label={t.name} id="name" name="name" required background={formBackground} />
        <Input label={t.email} type="email" id="email" name="email" required background={formBackground} />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <Input label={t.phone} type="tel" id="phone" name="phone" background={formBackground} />
        <Input label={t.company} id="company" name="company" background={formBackground} />
    </div>

    <Textarea label={t.message} id="message" name="message" required background={formBackground} />

    <Checkbox label={t.terms} id="terms" name="terms" required background={formBackground} />

    <div class="mt-6">
        <Button type="submit" variant="primary">
            {t.submit}
        </Button>
    </div>
</form>
