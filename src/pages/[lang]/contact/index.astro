---
import Layout from '@layouts/Layout.astro';
import InnerHero from '@components/sections/InnerHero.astro';
import ContactInfo from '@components/sections/ContactInfo.astro';
import { getEntry } from 'astro:content';
import { locales, type Lang } from '@i18n/utils';
import backgroundImage from '../../../assets/images/home/city-skyline-2-dark.jpg';

export function getStaticPaths() {
    return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const page = await getEntry('pages', `${lang}/contact`);
const d = page!.data;

const heroContent = {
    title: d.hero!.title,
    description: d.hero!.description,
    backgroundImage,
    overlayOpacity: 0.2,
};
---

<Layout title={d.seo.title} description={d.seo.description}>
    <InnerHero content={heroContent} />
    <ContactInfo background="base" padding="base" />
</Layout>
