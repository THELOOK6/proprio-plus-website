---
import Layout from '@layouts/Layout.astro';
import Button from '@components/ui/Button.astro';
import { getEntry } from 'astro:content';

// 404 is served as a single static page that can't know the visitor's locale,
// so we show both languages (French first).
const fr = (await getEntry('ui', 'fr/common'))!.data.notFound;
const en = (await getEntry('ui', 'en/common'))!.data.notFound;
---

<Layout title="404" description="Page introuvable / Page not found">
    <div class="w-full min-h-[80vh] flex items-center">
        <div class="site-container mx-auto px-4 py-base text-center">
            <div class="max-w-2xl mx-auto">
                <h1 class="mb-4 text-9xl font-bold text-primary" data-aos="fade-up">404</h1>
                <p class="text-body-base mb-2 text-lg" data-aos="fade-up" data-aos-delay="100">
                    {fr.message}
                </p>
                <p class="text-body-base/70 mb-12" data-aos="fade-up" data-aos-delay="150">
                    {en.message}
                </p>
                <div class="flex flex-wrap gap-4 justify-center" data-aos="fade-up" data-aos-delay="300">
                    <Button href="/fr/" variant="primary" size="lg">{fr.back}</Button>
                    <Button href="/en/" variant="ghostDark" size="lg">{en.back}</Button>
                </div>
            </div>
        </div>
    </div>
</Layout>
