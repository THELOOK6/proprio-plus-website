---
// Bare root redirects to the default (French) locale.
// Netlify handles this via public/_redirects; this page covers dev/preview and
// any client that lands on `/` directly.
const target = '/fr/';
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta http-equiv="refresh" content={`0; url=${target}`} />
        <link rel="canonical" href={target} />
        <meta name="robots" content="noindex" />
        <title>Proprio Alliance</title>
        <script is:inline>window.location.replace('/fr/');</script>
    </head>
    <body>
        <a href={target}>Proprio Alliance</a>
    </body>
</html>
